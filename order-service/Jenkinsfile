pipeline {
    agent any

    environment {
        HARBOR_REGISTRY = '192.168.0.13'
        HARBOR_PROJECT  = 'k8s_project'
        IMAGE_NAME      = 'order-service'
        IMAGE_TAG       = "v1.0-${BUILD_NUMBER}"
        FULL_IMAGE      = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG}"
        BACKUP_DIR      = '/var/jenkins_home/image-backups'
        SLACK_URL       = credentials('slack-webhook')
        K8S_MANIFEST    = 'k8s/healthshop/order-deployment.yaml'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Gradle Build') {
            steps {
                sh """
                    cd order-service
                    gradle classes --no-daemon -x test
                """
            }
            post {
                failure {
                                        sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#d00000\",\"text\":\"❌ Gradle 빌드 실패\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    script {
                        def scannerHome = tool 'sonar-scanner'
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=order-service \
                            -Dsonar.projectName=order-service \
                            -Dsonar.sources=order-service/src \
                            -Dsonar.java.binaries=order-service/build/classes
                        """
                    }
                }
            }
            post {
                failure {
                                        sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#d00000\",\"text\":\"❌ SonarQube 분석 실패\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t ${FULL_IMAGE} ./order-service"
            }
            post {
                failure {
                                        sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#d00000\",\"text\":\"❌ Docker 빌드 실패\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh "trivy image --exit-code 0 --severity CRITICAL --cache-dir /var/jenkins_home/.trivy-cache ${FULL_IMAGE}"
            }
            post {
                failure {
                                        sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#d00000\",\"text\":\"❌ Trivy 보안 스캔 실패\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
                }
            }
        }

        stage('Harbor Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'harbor-credentials',
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASS'
                )]) {
                    sh """
                        docker login ${HARBOR_REGISTRY} -u ${HARBOR_USER} -p ${HARBOR_PASS}
                        docker push ${FULL_IMAGE}
                    """
                }
            }
            post {
                failure {
                                        sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#d00000\",\"text\":\"❌ Harbor 푸시 실패\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
                }
            }
        }

        stage('Image Backup') {
            steps {
                sh """
                    mkdir -p ${BACKUP_DIR}
                    docker save ${FULL_IMAGE} | gzip > ${BACKUP_DIR}/${IMAGE_NAME}-${IMAGE_TAG}.tar.gz
                """
            }
        }

        stage('Update Manifest') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {
                    sh """
                        git checkout main
                        git pull origin main --no-rebase
                        sed -i 's|image: ${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}:.*|image: ${FULL_IMAGE}|' ${K8S_MANIFEST}
                        git config user.email "jenkins@geunuk.com"
                        git config user.name "Jenkins"
                        git add ${K8S_MANIFEST}
                        git diff --cached --quiet || git commit -m "ci: update ${IMAGE_NAME} image tag to ${IMAGE_TAG}"
                        git push https://${GIT_USER}:${GIT_PASS}@github.com/openyeongseo/k8s_project.git HEAD:main
                    """
                }
            }
            post {
                failure {
                                        sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#d00000\",\"text\":\"❌ 매니페스트 업데이트 실패\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
                }
            }
        }
    }

    post {
        success {
                                sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#36a64f\",\"text\":\"✅ 배포 성공!\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\nImage: ${FULL_IMAGE}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
        }
        failure {
                                sh "curl -s -X POST -H 'Content-type: application/json' --data '{\"attachments\":[{\"color\":\"#d00000\",\"text\":\"❌ 파이프라인 실패\nJob: ${JOB_NAME}\nBuild: #${BUILD_NUMBER}\n${BUILD_URL}\"}]}' $SLACK_URL || true"
        }
    }
}
